{
    "name": "vanilo/checkout",
    "description": "Vanilo Checkout Module",
    "type": "library",
    "license": "MIT",
    "keywords": ["checkout", "ecommerce", "vanilo", "artkonekt", "laravel"],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "support": {
        "source": "https://github.com/vanilophp/checkout"
    },
    "authors": [
        {
            "name": "Attila Fulop",
            "homepage": "https://github.com/fulopattila122"
        }
    ],
    "require": {
        "php": "^8.0|^8.2|^8.4",
        "konekt/concord": "^1.6"
    },
    "require-dev": {
        "phpunit/phpunit": "~8.0|~9.0|~10.0",
        "orchestra/testbench": "~4.0|~5.0|~6.0",
        "konekt/enum": "^3.0|^4.1"
    },
    "autoload": {
        "psr-4": { "Vanilo\\Checkout\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": {
            "Vanilo\\Checkout\\Tests\\": "tests/"
        }
    }
}
